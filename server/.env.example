# Server Environment
PORT=4000
NODE_ENV=development
WORKER_CONCURRENCY=2

# MySQL 8.x Database Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=uniportal
MYSQL_PASSWORD=secure_university_db_password
MYSQL_DATABASE=university_portal
MYSQL_POOL_LIMIT=20

# WhatsApp Cloud API (Meta) Credentials - Outside source code
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_NUMBER_ID=109283746501928
WHATSAPP_ACCESS_TOKEN=EAABcdef...your_meta_token_here
WHATSAPP_WEBHOOK_VERIFY_TOKEN=uni_webhook_verify_secret_token_9981

# Queue & Retry Policy
QUEUE_MAX_RETRIES=3
QUEUE_BASE_BACKOFF_SECONDS=5
QUEUE_LOCK_TIMEOUT_SECONDS=300

# Private Storage Directory (Outside Web Root)
UPLOAD_STORAGE_DIR=/var/lib/university-portal/uploads

[Unit]
Description=University Enterprise Communication Portal - Frontend UI Production Server
After=network.target

[Service]
Type=simple
User=uniportal
Group=uniportal
WorkingDirectory=/opt/university-portal/client
Environment=PORT=3000
Environment=NODE_ENV=production
ExecStart=/usr/bin/npx serve -s dist -l 3000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=uniportal-web

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
